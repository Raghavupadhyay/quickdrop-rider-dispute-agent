# Copy to .env and fill in. docker compose reads this file for ${GROQ_API_KEY} / ${GROQ_MODEL}.

# LLM used only to read the rider's message into structured claims (never to decide money).
# Free key: https://console.groq.com. Leave empty to run with the rule-based extractor only.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Set by docker-compose for the containers; only needed when running the service outside Docker.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/quickdrop
PAYSWIFT_BASE_URL=http://localhost:8081
